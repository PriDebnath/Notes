  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --ext ts,json --exec ts-node src/server.ts",
    "dev:ts-node-dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "dev:nodemon": "nodemon --legacy-watch --watch src --ext ts,json --exec ts-node src/server.ts",
    "build": "tsc",
    "start:redis": "redis-server --ignore-warnings ARM64-COW-BUG",
    "start": "node dist/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down -v",
    "db:generate": "bunx drizzle-kit generate --config=./src/drizzle.config.ts",
    "db:migrate": "bunx drizzle-kit migrate --config=./src/drizzle.config.ts",
    "db:studio": "bunx drizzle-kit studio --config=./src/drizzle.config.ts"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "autocannon": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.10",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "drizzle-orm": "^0.45.1",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14",
    "nanoid": "^5.1.11",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.5",
    "redis": "^5.12.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/pg": "^8.16.0",
    "bun-types": "latest",
